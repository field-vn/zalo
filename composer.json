{
    "name": "field-vn/zalo",
    "description": "Zalo OA & Bot SDK cho Laravel",
    "keywords": ["laravel", "php", "zalo"],
    "homepage": "https://github.com/field-vn/zalo",
    "license": "MIT",
    "authors": [
        {
            "name": "Field Tech Vietnam",
            "email": "trieu.nguyennhu@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "larastan/larastan": "^2.0|^3.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "FieldVn\\Zalo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FieldVn\\Zalo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FieldVn\\Zalo\\Laravel\\ZaloServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
