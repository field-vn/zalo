{
    "name": "field-vn/zalo",
    "description": "Zalo OA & Bot SDK cho Laravel — quản lý nhiều OA, tự refresh token, có UI cấu hình",
    "keywords": [
        "laravel",
        "php",
        "zalo",
        "zalo-oa",
        "zalo-bot",
        "vietnam",
        "chatbot"
    ],
    "homepage": "https://github.com/field-vn/zalo",
    "license": "MIT",
    "authors": [
        {
            "name": "Field Tech Vietnam",
            "email": "trieu.nguyennhu@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/field-vn/zalo/issues",
        "source": "https://github.com/field-vn/zalo",
        "docs": "https://github.com/field-vn/zalo#readme"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.0|^3.0|^4.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "FieldVn\\Zalo\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "FieldVn\\Zalo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FieldVn\\Zalo\\Laravel\\ZaloServiceProvider"
            ],
            "aliases": {
                "Zalo": "FieldVn\\Zalo\\Laravel\\Facades\\Zalo"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
